<?xml version="1.0" encoding="UTF-8"?>
<!-- Text Probe: ExtendScript read/write of Source Text on the selected clips (docs/PREMIERE_FACTS.md). -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.cutdeck.textprobe" ExtensionBundleVersion="0.1.0"
	ExtensionBundleName="CutDeck Text Probe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ExtensionList>
		<Extension Id="com.cutdeck.textprobe.panel" Version="0.1.0" />
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<Host Name="PPRO" Version="[22.0,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="9.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="com.cutdeck.textprobe.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./index.html</MainPath>
					<ScriptPath>./host.jsx</ScriptPath>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>CutDeck Text Probe</Menu>
					<Geometry>
						<Size>
							<Height>500</Height>
							<Width>420</Width>
						</Size>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
