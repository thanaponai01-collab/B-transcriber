{
  "tokens": [
    {
      "text": "ผู้หญิงคนนั้นโทรเข้ามา",
      "script": "thai",
      "start_ms": 0,
      "end_ms": 1400
    },
    {
      "text": "หนูกับแฟนหนู อยู่ในสถานะอะไร",
      "script": "thai",
      "start_ms": 1400,
      "end_ms": 4140
    },
    {
      "text": "หนูก็บอกว่า ก็เป็นเหมือนกัน",
      "script": "thai",
      "start_ms": 4760,
      "end_ms": 6900
    },
    {
      "text": "ฉันสามีภรรยา",
      "script": "thai",
      "start_ms": 6900,
      "end_ms": 8160
    },
    {
      "text": "เพิ่งมาอยู่ด้วยกัน ประมาณเกือบปีได้",
      "script": "thai",
      "start_ms": 8160,
      "end_ms": 10480
    },
    {
      "text": "เขาก็บอกสถานะเขาว่า ยี่สิบปีที่ผ่านมา",
      "script": "thai",
      "start_ms": 10480,
      "end_ms": 13800
    },
    {
      "text": "โอ้โห",
      "script": "thai",
      "start_ms": 13800,
      "end_ms": 14660
    },
    {
      "text": "แปลว่าเขาคบกันมา ยี่สิบปีอย่างนี้เหรอคะ",
      "script": "thai",
      "start_ms": 14660,
      "end_ms": 17020
    },
    {
      "text": "ค่ะ",
      "script": "thai",
      "start_ms": 17020,
      "end_ms": 18260
    },
    {
      "text": "โอ้โห",
      "script": "thai",
      "start_ms": 18260,
      "end_ms": 18880
    },
    {
      "text": "โดยที่หนูไม่รู้อะไรเลย",
      "script": "thai",
      "start_ms": 18880,
      "end_ms": 20700
    },
    {
      "text": "ไม่รู้เลย",
      "script": "thai",
      "start_ms": 20700,
      "end_ms": 23080
    },
    {
      "text": "คือปัญหาเนี้ย หนูแก้ไม่ได้หรอก",
      "script": "thai",
      "start_ms": 23080,
      "end_ms": 25780
    },
    {
      "text": "ตอนนี้มันเป็นเรื่อง ระหว่างเขากับผู้หญิงคนนั้น",
      "script": "thai",
      "start_ms": 25780,
      "end_ms": 28220
    },
    {
      "text": "ซึ่ง...",
      "script": "thai",
      "start_ms": 28220,
      "end_ms": 28740
    },
    {
      "text": "เขาต้องเป็นคนแก้ให้เรา",
      "script": "thai",
      "start_ms": 28740,
      "end_ms": 30380
    },
    {
      "text": "ซึ่งปฏิเสธไม่ได้หรอกว่า",
      "script": "thai",
      "start_ms": 30380,
      "end_ms": 31320
    },
    {
      "text": "แฟนลี่อ่ะ หลอกลี่แหละ",
      "script": "thai",
      "start_ms": 31320,
      "end_ms": 32420
    },
    {
      "text": "เลือกผิดก็เลือกใหม่ค่ะ น้องขา",
      "script": "thai",
      "start_ms": 32420,
      "end_ms": 34080
    },
    {
      "text": "จริงๆ ชีวิตของคนเรามีแค่นี้นะ",
      "script": "thai",
      "start_ms": 34080,
      "end_ms": 35920
    }
  ]
}